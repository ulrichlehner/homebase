// Debug launcher: the tests of the open file, with the dev container's Python (the
// ./homebase wrapper runs everything in Docker, where no debugger attaches). It does not
// touch the portal or the data folder, so it is safe to use anywhere.
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-p", "no:cacheprovider", "${file}"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
