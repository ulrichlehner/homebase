// LINZ NETZ smart meter (Develco, manufacturer DEV, version 0x01, type 0x02).
//
// Why this driver exists: LN-666 specifies the energy counters (1.8.0 import, 2.8.0 export)
// in Wh, i.e. DIF/VIF 0E 03 and 0E 83 3C. Several times a day, for about half an hour, the
// meter sends other records instead:
//   - VIF 0x04, 0x05, 0x07 (10, 100, 10^4 Wh): sometimes the digits are in that unit,
//     sometimes they are the Wh counter with a wrong VIF. One telegram does not tell which,
//     and a driver has no previous value to compare with,
//   - VIF 0x00 with all digits zero.
// The builtin amiplus accepts any energy VIF, so Home Assistant sees jumps and resets.
//
// Fix: the energy values only come from the records LN-666 specifies (difvifkey 0E03 and
// 0E833C). Any other energy record gives null (no value); power and date stay. Each energy
// field is defined twice: first for any energy record, scaled to 0 and turned into null, then
// for the LN-666 record, which wins when it is there. The null keeps the field in every
// telegram: the wmbusmeters add-on (3.1.0) builds the Home Assistant entities from the first
// telegram after a start and removes those it does not contain.
// Differences from the builtin amiplus: the energy fields match by difvifkey instead of
// vif_range, a dummy detect triplet, and no voltage, tariff or reactive fields (this meter
// does not send them). Field names match amiplus, so Home Assistant entities keep working.
//
// The detect triplet is a dummy that this meter never sends (real: DEV,01,02). With the real
// one, wmbusmeters removes the builtin amiplus as soon as this file is loaded. This driver is
// therefore never auto-detected: select it explicitly in the meter config.
driver {
    name           = amiplus_linznetz
    meter_type     = ElectricityMeter
    default_fields = name,id,total_energy_consumption_kwh,current_power_consumption_kw,total_energy_production_kwh,current_power_production_kw,timestamp
    detect {
        mvt = DEV,FE,02
    }
    fields {
        field {
            name              = total_energy_consumption
            quantity          = Energy
            info              = 'No value (null) for every energy record that is not the LN-666 one.'
            vif_scaling       = None
            force_scale       = 0
            null_value        = 0
            match {
                measurement_type = Instantaneous
                vif_range        = AnyEnergyVIF
            }
        }
        field {
            name              = total_energy_consumption
            quantity          = Energy
            info              = 'The total energy consumption recorded by this meter (only the Wh record from LN-666).'
            vif_scaling       = Auto
            dif_signedness    = Signed
            match {
                difvifkey = 0E03
            }
        }
        field {
            name           = current_power_consumption
            quantity       = Power
            info           = 'Current power consumption.'
            vif_scaling    = Auto
            dif_signedness = Signed
            match {
                measurement_type = Instantaneous
                vif_range        = PowerW
            }
        }
        field {
            name              = total_energy_production
            quantity          = Energy
            info              = 'No value (null) for every energy record that is not the LN-666 one.'
            vif_scaling       = None
            force_scale       = 0
            null_value        = 0
            match {
                measurement_type = Instantaneous
                vif_range        = AnyEnergyVIF
                add_combinable   = BackwardFlow
            }
        }
        field {
            name              = total_energy_production
            quantity          = Energy
            info              = 'The total energy production recorded by this meter (only the Wh record from LN-666).'
            vif_scaling       = Auto
            dif_signedness    = Signed
            match {
                difvifkey = 0E833C
            }
        }
        field {
            name           = current_power_production
            quantity       = Power
            info           = 'Current power production.'
            vif_scaling    = Auto
            dif_signedness = Signed
            match {
                measurement_type = Instantaneous
                vif_range        = PowerW
                add_combinable   = BackwardFlow
            }
        }
        field {
            name         = device
            quantity     = PointInTime
            info         = 'Device date time.'
            display_unit = datetime
            match {
                measurement_type = Instantaneous
                vif_range        = DateTime
            }
        }
    }
}
