#!/usr/bin/env bash
#
# Docker wrapper for the homebase tools. Nothing needs to be installed locally
# except Docker. The image is built locally, and rebuilt automatically whenever
# the sources in ./lib or ./databot change. The regular fetching runs in the
# Home Assistant add-on (linznetz_energy/); these commands are for manual use.
#
#   ./homebase csv                 update the readings CSV in DATA_DIR from the portal (+ unified file)
#   ./homebase render [args]       render the current chart from the CSV; `--archive` adds finished weeks
#   ./homebase render --all        re-render ALL weekly charts (originals are kept in original_charts/)
#   ./homebase reconstruct         reconstruct 6h values from the chart PNGs in DATA_DIR (+ split, unified file)
#   ./homebase disaggregate        split the reconstructed 6h blocks into quarter hours (+ unified file)
#   ./homebase fuse [--live FILE]  fuse live counter (HA history CSV), portal and reconstruction into hours
#   ./homebase ha-spike CMD        HA statistics import test (info | import | clear), needs HA_URL/HA_TOKEN
#   ./homebase assets [--check]    render the add-on icon/logo PNGs from linznetz_energy/assets/*.svg
#   ./homebase merge               rewrite the unified <meterId>_all.csv from the files above
#   ./homebase check               report incomplete days in the readings CSV
#   ./homebase databot <args>      any databot command, e.g. `databot csv --overlap 30`
#   ./homebase test                run the unit tests
#   ./homebase build               force a rebuild of the image
#   ./homebase shell               open a shell inside the container
#
# Configuration comes from ./.env (see README). DATA_DIR selects the folder that is
# mounted as /app/export in the container (default: ./data/databot). Put it in iCloud
# to keep the CSV files safe.

set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")"

IMAGE="homebase-databot:local"
# the image holds the shared library (lib/) and the command line tools (databot/)
SRC_DIRS=(./lib ./databot)
ENV_FILE="./.env"

die() { echo "error: $*" >&2; exit 1; }

[ -f "$ENV_FILE" ] || die "$ENV_FILE not found, see README for the required variables"
command -v docker >/dev/null || die "docker is not installed"

# Read DATA_DIR and METER_ID from .env without exporting everything into this shell
env_value() { grep -E "^$1=" "$ENV_FILE" | tail -1 | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//"; }
DATA_DIR="$(env_value DATA_DIR)"
DATA_DIR="${DATA_DIR:-./data/databot}"
DATA_DIR="${DATA_DIR/#\~/$HOME}"
METER_ID="$(env_value METER_ID)"
TZ_VALUE="$(env_value TZ)"
mkdir -p "$DATA_DIR"
DATA_DIR="$(cd "$DATA_DIR" && pwd)"

# -- Image build, only when the sources changed ------------------------------

source_hash() {
  # hash of every file that goes into the image
  find "${SRC_DIRS[@]}" -type f \( -name '*.py' -o -name '*.sh' -o -name 'requirements*.txt' -o -name Dockerfile \
    -o -name pyproject.toml \) -not -path '*/tests/*' -not -path '*.egg-info*' -print0 \
    | sort -z | xargs -0 shasum -a 256 | shasum -a 256 | cut -d' ' -f1
}

image_hash() {
  docker image inspect --format '{{ index .Config.Labels "homebase.source" }}' "$IMAGE" 2>/dev/null || true
}

build() {
  echo ">> building image $IMAGE"
  docker build --label "homebase.source=$(source_hash)" -t "$IMAGE" -f databot/Dockerfile .
}

ensure_image() {
  if [ "$(image_hash)" != "$(source_hash)" ]; then
    build
  fi
}

# -- Run helpers --------------------------------------------------------------

# One-off container with DATA_DIR mounted as /app/export
run_standalone() {
  local tty_flags="-i"
  [ -t 0 ] && [ -t 1 ] && tty_flags="-it"
  docker run --rm $tty_flags \
    --env-file "$ENV_FILE" \
    -e EXPORT_DIR=/app/export \
    -v "$DATA_DIR:/app/export" \
    "$IMAGE" "$@"
}

usage() { sed -n '3,25p' "$0"; }

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
  csv)
    ensure_image
    run_standalone python3 /app/databot.py csv "$@"
    ;;
  disaggregate)
    ensure_image
    # profile from the readings, input <meterId>_reconstructed_6h.csv, output <meterId>_reconstructed_15min.csv
    run_standalone python3 /app/databot.py disaggregate "$@"
    # refresh the unified file, unless only the backtest ran
    case " $* " in *" --backtest "*) ;; *) run_standalone python3 /app/databot.py merge ;; esac
    ;;
  fuse)
    ensure_image
    # a history file outside DATA_DIR is mounted read-only into the container
    extra=() args=()
    while [ $# -gt 0 ]; do
      if { [ "$1" = "--live" ] || [ "$1" = "--rf" ]; } && [ $# -gt 1 ]; then
        [ -f "$2" ] || die "history file $2 not found"
        extra=(-v "$(cd "$(dirname "$2")" && pwd)/$(basename "$2"):/app/live.csv:ro")
        args+=(--live /app/live.csv); shift 2
      else
        args+=("$1"); shift
      fi
    done
    tty_flags="-i"; [ -t 0 ] && [ -t 1 ] && tty_flags="-it"
    docker run --rm $tty_flags --env-file "$ENV_FILE" -e EXPORT_DIR=/app/export -v "$DATA_DIR:/app/export" \
      ${extra[@]+"${extra[@]}"} "$IMAGE" python3 /app/databot.py fuse ${args[@]+"${args[@]}"}
    ;;
  ha-spike)
    ensure_image
    # containers cannot resolve mDNS names (homeassistant.local): resolve on the host
    ha_host="$( (env_value HA_URL || true) | sed -E 's#^[a-z]+://##; s#[:/].*$##')"
    host_flags=()
    if [[ "$ha_host" == *.local ]]; then
      ha_ip="$(dscacheutil -q host -a name "$ha_host" 2>/dev/null | awk '/^ip_address/ {print $2; exit}')"
      [ -n "$ha_ip" ] || die "cannot resolve $ha_host"
      host_flags=(--add-host "$ha_host:$ha_ip")
    fi
    docker run --rm -i --env-file "$ENV_FILE" -e EXPORT_DIR=/app/export -v "$DATA_DIR:/app/export" \
      ${host_flags[@]+"${host_flags[@]}"} "$IMAGE" python3 /app/ha_spike.py "$@"
    ;;
  assets)
    # own small image (cairo + DejaVu), independent of the databot image
    docker build -q -t homebase-assets linznetz_energy/assets >/dev/null
    docker run --rm -v "$PWD/linznetz_energy:/addon" --entrypoint python3 homebase-assets /addon/assets/render.py "$@"
    ;;
  merge)
    ensure_image
    run_standalone python3 /app/databot.py merge "$@"
    ;;
  reconstruct)
    ensure_image
    # charts, readings and the optional <meterId>_reconstructed_corrections.csv all live in DATA_DIR
    run_standalone python3 /app/reconstruct.py \
      --charts /app/export --meter "$METER_ID" --tz "${TZ_VALUE:-Europe/Vienna}" \
      --readings "/app/export/${METER_ID}_readings.csv" "$@"
    # refresh the quarter-hour split, then the unified file
    run_standalone python3 /app/databot.py disaggregate
    run_standalone python3 /app/databot.py merge
    ;;
  databot)
    ensure_image
    run_standalone python3 /app/databot.py "$@"
    ;;
  check)
    ensure_image
    run_standalone python3 /app/databot.py check "$@"
    ;;
  render)
    ensure_image
    run_standalone python3 /app/render.py "$@"
    ;;
  test)
    ensure_image
    # the sources are mounted, so the tests run against the working tree (pytest.ini sets the paths)
    docker run --rm -v "$PWD:/src" -w /src "$IMAGE" sh -c \
      'pip install -q pytest >/dev/null && python3 -m pytest -q -p no:cacheprovider'
    ;;
  build)
    build
    ;;
  shell)
    ensure_image
    run_standalone bash
    ;;
  ''|-h|--help|help)
    usage
    ;;
  *)
    die "unknown command '$cmd'. $(usage)"
    ;;
esac
